# Postgres connection string (Neon / Supabase / any Postgres).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Mapbox public access token — https://account.mapbox.com/access-tokens/
# Used by the map canvas, geocoding search and the Directions API.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Google Gemini API key — https://aistudio.google.com/apikey
# Used by the AI route assistant (/api/ai/generate).
GEMINI_API_KEY=""
